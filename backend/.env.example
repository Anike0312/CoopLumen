PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://cooplumen:cooplumen@localhost:5432/cooplumen

# PostgreSQL Pool Configuration (production hardening)
PGPOOL_MAX=10                    # Maximum number of connections in pool
PGPOOL_IDLE_TIMEOUT=30000       # Idle connection timeout in milliseconds (30s)
PGPOOL_CONNECTION_TIMEOUT=2000  # Connection timeout in milliseconds (2s)

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# The only account the server may sign transactions for (community distributor).
# Leave unset to disable server-side signing entirely.
STELLAR_DISTRIBUTOR_PUBLIC_KEY=

# Shared secret for verifying the HMAC-SHA256 signature on incoming
# POST /api/v1/webhooks/stellar requests. Required in production; requests
# are rejected with 503 when unset.
STELLAR_WEBHOOK_SECRET=

# Shared secret for third-party KYC callbacks sent to POST /api/v1/webhooks/kyc.
# Keep this separate from the Stellar event webhook secret.
KYC_WEBHOOK_SECRET=

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Secret used to sign wallet session tokens issued by POST /api/v1/auth/verify.
# Required in production; falls back to an insecure development default when
# unset outside production.
AUTH_SESSION_SECRET=

# Redis (optional). Backs the price and balance caches; when unset the caches
# fall back to their in-process tier and log a warning once at startup.
REDIS_URL=redis://localhost:6379

# Testnet end-to-end suites are skipped unless this is set to 1. They fund
# throwaway accounts through Friendbot and submit real transactions, so they
# need network access and take minutes rather than seconds.
STELLAR_TESTNET_E2E=
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Comma-separated Stellar addresses allowed to call operator-only routes
# (currently GET /api/v1/tokens). Unset means nobody qualifies and every such
# request is rejected with 403.
ADMIN_ADDRESSES=
